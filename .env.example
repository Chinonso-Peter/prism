# Copy to .env to override the defaults used by docker-compose.yml:
#   cp .env.example .env
# Every value below is the default that compose uses when the variable is unset.

# Stellar network: "testnet", "mainnet", or "futurenet".
NEXT_PUBLIC_NETWORK=testnet

# Horizon REST API endpoint. Compose defaults to the testnet endpoint, so set
# this and the Soroban RPC URL together when pointing at mainnet or futurenet.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint. The indexer polls the same URL.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Public site URL, used to build absolute OG/social image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
