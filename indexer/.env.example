# Postgres connection string
DATABASE_URL=postgresql://prism:prism@localhost:5432/prism

# Soroban RPC endpoint to poll
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# How often to poll for new ledgers, in milliseconds
POLL_INTERVAL_MS=5000

# Optional: first ledger to index on a fresh database. Must fall inside the RPC node's
# retention window. Ignored once the indexer has a cursor. Unset: start from the latest ledger.
# INDEXER_START_LEDGER=
